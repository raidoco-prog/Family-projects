# Supabase → Settings → API
#
# Left empty on purpose. isSupabaseConfigured only checks that these are
# non-empty, so a placeholder like https://your-project.supabase.co would
# satisfy it — and instead of the /setup screen explaining what is missing,
# you would get a login page that can never succeed.
#   URL looks like:      https://abcdefghijkl.supabase.co
#   anon key looks like: a long eyJ... token
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses every RLS policy — never expose to the browser
# and never give it a NEXT_PUBLIC_ prefix. Not needed until phase 4.
SUPABASE_SERVICE_ROLE_KEY=

# Where Google and the magic link send people back to. Must be the real
# production URL once deployed — the default below would bounce the family
# to their own laptop and nobody could sign in.
# (Invite links do not use this; they are built from the open tab's origin.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push (phase 4). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret the cron must present. Generate with: openssl rand -hex 32
CRON_SECRET=
