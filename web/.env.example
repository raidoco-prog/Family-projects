# Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Bypasses every RLS policy — never expose to the browser
# and never give it a NEXT_PUBLIC_ prefix. Not needed until phase 4.
SUPABASE_SERVICE_ROLE_KEY=

# Used to build invite links and OAuth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push (phase 4). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret the cron must present. Generate with: openssl rand -hex 32
CRON_SECRET=
