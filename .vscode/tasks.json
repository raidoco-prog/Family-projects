{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "התקנת תלויות",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/web" },
      "problemMatcher": []
    },
    {
      "label": "שרת פיתוח",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/web" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "בדיקת טיפוסים",
      "type": "shell",
      "command": "npm run typecheck",
      "options": { "cwd": "${workspaceFolder}/web" },
      "group": "test",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "בנייה",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/web" },
      "group": "build",
      "problemMatcher": ["$tsc"]
    }
  ]
}
