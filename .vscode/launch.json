{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "הרצת שרת הפיתוח",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "צירוף דיבאגר לדפדפן",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/web"
    }
  ],
  "compounds": [
    {
      "name": "שרת + דפדפן",
      "configurations": ["הרצת שרת הפיתוח", "צירוף דיבאגר לדפדפן"]
    }
  ]
}
